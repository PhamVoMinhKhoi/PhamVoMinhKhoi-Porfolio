CREATE OR REPLACE VIEW `my-project-sc-469703.project1.v_pareto_category` AS
WITH rev AS (
  SELECT
    category_name,
    SUM(sales) AS revenue
  FROM `my-project-sc-469703.project1.v_spc_features`
  GROUP BY category_name
),
ranked AS (
  SELECT
    category_name,
    revenue,
    revenue / SUM(revenue) OVER ()                                           AS pct_of_total,
    SUM(revenue) OVER (ORDER BY revenue DESC)
      / SUM(revenue) OVER ()                                                 AS cum_pct,
    ROW_NUMBER() OVER (ORDER BY revenue DESC)                                AS rnk
  FROM rev
)
SELECT
  category_name,
  revenue,
  pct_of_total,
  cum_pct,
  rnk,
  IF(cum_pct <= 0.8, 1, 0) AS in_top_80pct
FROM ranked
ORDER BY revenue DESC;
