CREATE OR REPLACE VIEW `my-project-sc-469703.project1.v_late_by_mode_region` AS
SELECT
  shipping_mode,
  order_region,
  COUNT(*)                                        AS n_orders,
  AVG(CAST(late_delivery_risk AS FLOAT64))        AS late_rate,
  AVG(lateness_days)                               AS avg_lateness_days
FROM `my-project-sc-469703.project1.v_spc_features`
GROUP BY shipping_mode, order_region
ORDER BY late_rate DESC, n_orders DESC;
