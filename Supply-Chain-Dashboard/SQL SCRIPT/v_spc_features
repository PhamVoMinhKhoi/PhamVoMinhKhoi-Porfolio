CREATE OR REPLACE VIEW `my-project-sc-469703.project1.v_spc_features` AS
WITH base AS (
  SELECT
    CAST(order_date   AS DATE) AS order_date,
    CAST(shipping_date AS DATE) AS shipping_date,

    order_id, order_item_id, customer_id,
    product_card_id, product_category_id,

    EXTRACT(YEAR       FROM CAST(order_date AS DATE)) AS order_year,
    DATE_TRUNC(CAST(order_date AS DATE), MONTH)       AS order_month,
    EXTRACT(DAYOFWEEK  FROM CAST(order_date AS DATE)) AS order_dow,
    IF(EXTRACT(DAYOFWEEK FROM CAST(order_date AS DATE)) IN (1,7), 1, 0) AS is_weekend,
    DATE_TRUNC(CAST(order_date AS DATE), WEEK(MONDAY)) AS order_week,

    days_for_shipping_real,
    days_for_shipment_scheduled,
    (days_for_shipping_real - days_for_shipment_scheduled) AS lateness_days,
    late_delivery_risk,
    delivery_status,
    shipping_mode,

    COALESCE(customer_lname, 'Unknown') AS customer_lname,
    COALESCE(CAST(customer_zipcode AS STRING), 'Unknown') AS customer_zipcode,
    customer_segment, customer_state, customer_country,
    market, order_region, order_state, order_country, order_city,

    category_id, category_name,
    department_id, department_name,
    product_name, product_status,

    SAFE_CAST(sales AS FLOAT64) AS sales,
    SAFE_CAST(order_profit_per_order AS FLOAT64) AS profit,
    SAFE_DIVIDE(order_profit_per_order, NULLIF(sales,0)) AS profit_margin,
    COALESCE(order_item_discount, 0)        AS order_item_discount,
    COALESCE(order_item_discount_rate, 0)   AS order_item_discount_rate,
    order_item_quantity,
    order_item_product_price,
    order_item_total,
    type
  FROM `my-project-sc-469703.project1.SPC_data`
  WHERE order_date IS NOT NULL
)
-- Chỉ loại order_zipcode, vì product_description không có trong schema
SELECT
  * 
FROM base;
