CREATE OR REPLACE VIEW `my-project-sc-469703.project1.v_spc_features_model_safe` AS
SELECT
  -- Time known at order time
  order_date,
  order_year,
  order_month,
  order_week,
  order_dow,
  is_weekend,

  -- Shipment info known before delivery
  days_for_shipment_scheduled,
  shipping_mode,

  -- Pricing/quantity at order time
  order_item_quantity,
  SAFE_CAST(order_item_product_price AS FLOAT64) AS order_item_product_price,
  COALESCE(order_item_discount, 0)               AS order_item_discount,
  COALESCE(order_item_discount_rate, 0)          AS order_item_discount_rate,
  SAFE_CAST(order_item_total AS FLOAT64)         AS order_item_total,
  SAFE_CAST(sales AS FLOAT64)                    AS sales,

  -- Segments & geography
  market, order_region, order_state, order_country, order_city,
  category_name, department_name, customer_segment,

  -- Target label (ví dụ cho classification)
  late_delivery_risk
FROM `my-project-sc-469703.project1.v_spc_features`
WHERE order_date IS NOT NULL;
